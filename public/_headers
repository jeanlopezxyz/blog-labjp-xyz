# Security headers (X-Frame-Options, CSP, HSTS, etc.) are set by
# functions/_middleware.ts, which runs for every request and is the
# single source of truth. This file only handles caching, since
# _headers rules for static assets are applied before the middleware.

/api/*
  Cache-Control: no-cache, no-store, must-revalidate

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
