---
import TagPage from "@/components/views/TagPage.astro";
import { getCollection } from "astro:content";
import { isPostForLang } from "@/i18n";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const enPosts = allPosts.filter(({ id }) => isPostForLang(id, 'en'));
  const esTags = new Set(
    allPosts.filter(({ id }) => isPostForLang(id, 'es')).flatMap((post) => post.data.tags),
  );
  const tags = [...new Set(enPosts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: enPosts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      hasTranslation: esTags.has(tag),
    },
  }));
}

const { tag, posts, hasTranslation } = Astro.props;
---

<TagPage lang="en" tag={tag} posts={posts} hasTranslation={hasTranslation} />
