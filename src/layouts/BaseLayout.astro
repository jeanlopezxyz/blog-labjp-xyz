---
import "@/styles/global.css";
import { SITE, SOCIAL } from "@/lib/constants";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import ScrollToTop from "@/components/ui/ScrollToTop.astro";
import { getLangFromUrl, useTranslations, getClientI18n, getLocalizedPath, type Lang } from "@/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  publishedTime?: string;
  currentCategory?: string;
  showCategories?: boolean;
  lang?: Lang;
  keywords?: string[];
  /** Set to false when this page has no counterpart in the other language, to avoid emitting a hreflang link to a 404. */
  hasTranslation?: boolean;
  /** Set to true for thin-content pages (e.g. tag pages with very few posts) that shouldn't be indexed. */
  noindex?: boolean;
}

const urlLang = getLangFromUrl(Astro.url);
const {
  title,
  description,
  image = "/og-image.png",
  canonicalUrl,
  type = "website",
  publishedTime,
  currentCategory,
  lang = urlLang,
  keywords = ["Kubernetes", "OpenShift", "Cloud Native", "DevOps", "Java", "Red Hat"],
  hasTranslation = true,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);
const i18n = getClientI18n(lang);
const localizedPath = Astro.url.pathname.replace(/^\/(?:es|en)(?=\/|$)/, '') || '/';
const canonical = canonicalUrl || new URL(getLocalizedPath(localizedPath, lang), SITE.url).href;
const siteLocale = SITE.locales[lang];
// og:locale wants underscore-separated locale codes (es_ES), while
// siteLocale.locale is BCP-47 (es-ES) for Intl.DateTimeFormat elsewhere.
const ogLocale = siteLocale.locale.replace('-', '_');
const ogLocaleAlternate = (lang === 'es' ? SITE.locales.en : SITE.locales.es).locale.replace('-', '_');
const defaultTitle = siteLocale.title;
const defaultDescription = siteLocale.description;
const finalTitle = title || defaultTitle;
const finalDescription = description || defaultDescription;
// Google truncates titles past ~60-65 chars, so long post titles get
// shortened before the " | labjp.xyz" suffix is appended.
const TITLE_LIMIT = 60;
const suffix = ` | ${SITE.name}`;
const truncatedTitle =
  finalTitle.length > TITLE_LIMIT
    ? `${finalTitle.slice(0, TITLE_LIMIT - 1).trimEnd()}…`
    : finalTitle;
const fullTitle = finalTitle === defaultTitle ? finalTitle : `${truncatedTitle}${suffix}`;

// JSON-LD Schema for Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE.name,
  "url": SITE.url,
  "logo": `${SITE.url}/android-chrome-512x512.png`,
  "description": defaultDescription,
  "founder": {
    "@type": "Person",
    "name": SITE.author,
    "jobTitle": "Senior Consultant",
    "worksFor": {
      "@type": "Organization",
      "name": "Red Hat"
    }
  },
  "sameAs": [
    SOCIAL.github,
    SOCIAL.linkedin,
    SOCIAL.twitter
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "email": SITE.email,
    "contactType": "customer service"
  }
};

// JSON-LD Schema for WebSite with SearchAction
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE.name,
  "url": SITE.url,
  "description": defaultDescription,
  "inLanguage": ["es", "en"],
  "author": {
    "@type": "Person",
    "name": SITE.author
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
    "urlTemplate": `${SITE.url}/${lang}/blog?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

// Breadcrumb schema
const pathSegments = localizedPath.split('/').filter(Boolean);
const breadcrumbItems = pathSegments.map((segment, index) => {
  const path = getLocalizedPath('/' + pathSegments.slice(0, index + 1).join('/'), lang);
  return {
    "@type": "ListItem",
    "position": index + 2,
    "name": segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
    "item": `${SITE.url}${path}`
  };
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": SITE.url
    },
    ...breadcrumbItems
  ]
};

// Person schema for author (helps with Google Knowledge Panel)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": SITE.author,
  "url": SITE.url,
  "jobTitle": "Senior Consultant",
  "worksFor": {
    "@type": "Organization",
    "name": "Red Hat",
    "url": "https://www.redhat.com"
  },
  "alumniOf": {
    "@type": "Organization",
    "name": "Universidad Nacional de Ingeniería"
  },
  "knowsAbout": ["Kubernetes", "OpenShift", "Cloud Native", "DevOps", "Java", "Microservices", "GitOps"],
  "sameAs": [
    SOCIAL.github,
    SOCIAL.linkedin,
    SOCIAL.twitter
  ],
  "description": "Senior Consultant at Red Hat specializing in Kubernetes, OpenShift, and Cloud Native architectures."
};

---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Applied before anything else paints, so the saved theme (or the
         dark default) is set before first render instead of flashing. -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const isDark = stored === null || stored === 'dark';
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Sitemap & Feeds -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'} />

    <!-- Hreflang for multilingual SEO (only when this page has a real counterpart in each language) -->
    <link rel="alternate" hreflang={lang} href={`${SITE.url}${getLocalizedPath(localizedPath, lang)}`} />
    {hasTranslation && (
      <>
        <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={`${SITE.url}${getLocalizedPath(localizedPath, lang === 'es' ? 'en' : 'es')}`} />
        <link rel="alternate" hreflang="x-default" href={`${SITE.url}${getLocalizedPath(localizedPath, 'es')}`} />
      </>
    )}

    <meta name="generator" content={Astro.generator} />

    <!-- Search Engine Verification (replace with your actual codes) -->
    <!-- <meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE" /> -->
    <!-- <meta name="msvalidate.01" content="YOUR_BING_VERIFICATION_CODE" /> -->
    <!-- <meta name="yandex-verification" content="YOUR_YANDEX_CODE" /> -->

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={finalDescription} />
    <meta name="author" content={SITE.author} />
    <meta name="creator" content={SITE.author} />
    <meta name="publisher" content={SITE.name} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="subject" content="Kubernetes, OpenShift, Cloud Native, DevOps" />
    <meta name="language" content={lang} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="bingbot" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonical} />

    <!-- Mobile & PWA Meta Tags -->
    <meta name="theme-color" content="#22c55e" />
    <meta name="msapplication-TileColor" content="#22c55e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="application-name" content={SITE.name} />
    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={new URL(image, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={finalTitle} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:author" content={SITE.author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jeanlopezxyz" />
    <meta name="twitter:creator" content="@jeanlopezxyz" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={new URL(image, SITE.url).href} />
    <meta name="twitter:image:alt" content={finalTitle} />

    <!-- JSON-LD Structured Data for Rich Results -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {breadcrumbItems.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- i18n for client scripts -->
    <script is:inline define:vars={{ i18n }}>
      window.__i18n = i18n;
    </script>

    <!-- View Transitions -->
    <meta name="view-transition" content="same-origin" />

    <!-- Slot for additional head content (e.g., page-specific JSON-LD) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background flex flex-col">
    <!-- Skip link for accessibility -->
    <a href="#main-content" class="skip-link">
      {t('a11y.skipToContent')}
    </a>

    <Header currentCategory={currentCategory} hasTranslation={hasTranslation} />
    <main id="main-content" class="page-content flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <ScrollToTop />
  </body>
</html>

<style>
  @view-transition {
    navigation: auto;
  }

  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--color-primary);
    color: white;
    padding: 8px 16px;
    z-index: 100;
    transition: top 0.3s;
  }

  .skip-link:focus {
    top: 0;
  }
</style>
