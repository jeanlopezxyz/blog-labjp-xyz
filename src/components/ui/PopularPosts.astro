---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { getBlogPostUrl } from "@/lib/utils";
import { getThumbnailUrl } from "@/lib/images";
import { useTranslations, defaultLang, isPostForLang, normalizeSlug, type Lang } from "@/i18n";

interface Props {
  lang?: Lang;
  limit?: number;
}

const { lang = defaultLang, limit = 5 } = Astro.props;
const t = useTranslations(lang);
const posts = (await getCollection("blog", ({ id, data }) => !data.draft && isPostForLang(id, lang)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<section
  class="terminal-panel p-5"
  data-popular-posts
  data-limit={limit}
  data-popular-title={t('stats.mostViewed')}
  data-view-label={t('stats.views')}
>
  <div class="mb-4 flex items-center gap-2">
    <Icon name="mdi:clock-outline" class="h-4 w-4 text-primary" aria-hidden="true" />
    <h2 class="font-mono text-xs font-semibold uppercase tracking-wide text-muted-foreground" data-list-title>
      {t('home.latest')}
    </h2>
  </div>

  <ol class="space-y-4">
    {posts.map((post, index) => (
      <li data-post-slug={normalizeSlug(post.id)} class:list={{ hidden: index >= limit }}>
        <a href={getBlogPostUrl(post.id, lang)} class="group block">
          {post.data.image && (
            <div class="mb-2 aspect-[16/9] overflow-hidden rounded-sm border border-border/60 bg-muted">
              <img
                src={getThumbnailUrl(post.data.image, 640, 360)}
                alt={post.data.title}
                width="320"
                height="180"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          )}
          <h3 class="mb-1 line-clamp-2 text-sm font-medium leading-snug text-foreground transition-colors group-hover:text-primary">
            {post.data.title}
          </h3>
          <span class="hidden font-mono text-xs text-muted-foreground" data-view-count></span>
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  import { API_ENDPOINTS } from '@/lib/types';

  interface ViewData {
    slug: string;
    views: number;
  }

  function initPopularPosts() {
    document.querySelectorAll<HTMLElement>('[data-popular-posts]').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const list = container.querySelector('ol');
      const title = container.querySelector<HTMLElement>('[data-list-title]');
      if (!list || !title) return;
      const limit = Number.parseInt(container.dataset.limit || '5', 10);

      const items = new Map(
        Array.from(list.querySelectorAll<HTMLElement>('[data-post-slug]'))
          .map((item) => [item.dataset.postSlug, item] as const)
          .filter((entry): entry is [string, HTMLElement] => Boolean(entry[0]))
      );

      fetch(API_ENDPOINTS.VIEWS)
        .then((response) => {
          if (!response.ok) throw new Error('Views API unavailable');
          return response.json() as Promise<ViewData[]>;
        })
        .then((views) => {
          if (!Array.isArray(views)) return;

          const ranked = views
            .filter(({ slug, views: count }) => items.has(slug) && Number.isFinite(count))
            .slice(0, limit);

          if (ranked.length === 0) return;

          items.forEach((item) => item.classList.add('hidden'));
          ranked.forEach(({ slug, views: count }) => {
            const item = items.get(slug)!;
            const counter = item.querySelector<HTMLElement>('[data-view-count]');
            if (counter) {
              counter.textContent = `${count} ${container.dataset.viewLabel || 'views'}`;
              counter.classList.remove('hidden');
            }
            item.classList.remove('hidden');
            list.appendChild(item);
          });

          title.textContent = container.dataset.popularTitle || title.textContent;
        })
        .catch(() => {
          // Recent posts are already rendered as a useful local/offline fallback.
        });
    });
  }

  initPopularPosts();
  document.addEventListener('astro:after-swap', initPopularPosts);
</script>
