---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCardHorizontal from "@/components/blog/PostCardHorizontal.astro";
import SocialActions from "@/components/ui/SocialActions.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { calculateReadingTime, getBlogPostUrl, getRelativeTime } from "@/lib/utils";
import { getLocalizedPath, isPostForLang, normalizeSlug, slugToPostId, useTranslations, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const allPosts = (await getCollection("blog", ({ id, data }) => !data.draft && isPostForLang(id, lang)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = allPosts.find((post) => post.data.featured) ?? allPosts[0];
const restPosts = allPosts.filter((post) => post.id !== featuredPost?.id);
---

<BaseLayout lang={lang}>
  <div class="mx-auto max-w-screen-2xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <section class="mb-16" aria-labelledby="terminal-intro-title">
      <h1 id="terminal-intro-title" class="terminal-output sm:whitespace-nowrap">
        {lang === "es"
          ? "Cloud native, Kubernetes, IA y automatización."
          : "Cloud native, Kubernetes, AI, and automation."}
      </h1>
      <p class="terminal-description">
        {lang === "es"
          ? "Notas de campo sobre Kubernetes, OpenShift, IA, automatización y sistemas en producción."
          : "Field notes on Kubernetes, OpenShift, AI, automation, and production systems."}
      </p>
    </section>

    {featuredPost ? (
      <>
        <article class="group mb-16 grid gap-8 lg:grid-cols-2 lg:items-center">
          {featuredPost.data.image && (
            <a href={getBlogPostUrl(featuredPost.id, lang)} class="block order-1 lg:order-2">
              <div class="aspect-[16/10] overflow-hidden rounded-md bg-muted">
                <img
                  src={featuredPost.data.image}
                  alt={featuredPost.data.title}
                  width="800"
                  height="500"
                  decoding="async"
                  fetchpriority="high"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
            </a>
          )}
          <div class="order-2 lg:order-1">
            <a href={getBlogPostUrl(featuredPost.id, lang)} class="block">
              <h2 class="mb-3 text-2xl font-bold leading-tight transition-colors group-hover:text-primary md:text-3xl">
                {featuredPost.data.title}
              </h2>
              <p class="mb-4 leading-relaxed text-muted-foreground">{featuredPost.data.description}</p>
              <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
                <time datetime={featuredPost.data.pubDate.toISOString()}>
                  {getRelativeTime(featuredPost.data.pubDate, lang)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{calculateReadingTime(featuredPost.body ?? "")} min</span>
              </div>
            </a>
            <div class="mt-5">
              <SocialActions
                postId={slugToPostId(featuredPost.id)}
                postTitle={featuredPost.data.title}
                postSlug={normalizeSlug(featuredPost.id)}
                lang={lang}
                showComments={true}
                size="sm"
              />
            </div>
          </div>
        </article>

        {restPosts.length > 0 && (
          <section>
            <div class="mb-6 flex items-center justify-between">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">{t("home.latest")}</h2>
              <a href={getLocalizedPath("/blog", lang)} class="text-sm text-primary hover:underline">
                {t("home.viewAll")} →
              </a>
            </div>
            <div class="grid gap-x-10 sm:grid-cols-2">
              {restPosts.map((post) => (
                <PostCardHorizontal
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  slug={post.id}
                  image={post.data.image}
                  readingTime={calculateReadingTime(post.body ?? "")}
                  lang={lang}
                />
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="py-16 text-center">
        <Icon name="mdi:file-document-outline" class="mx-auto mb-4 h-12 w-12 text-muted-foreground" />
        <h2 class="mb-2 text-lg font-semibold">{t("home.noArticles")}</h2>
        <p class="text-sm text-muted-foreground">{t("home.articlesWillAppear")}</p>
      </div>
    )}
  </div>
</BaseLayout>
