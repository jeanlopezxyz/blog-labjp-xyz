---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { SITE, SOCIAL } from "@/lib/constants";
import type { Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = {
  es: {
    title: "Sobre mí",
    description: `Conoce más sobre ${SITE.author} y blog.labjp.xyz`,
    lead: "Voy aprendiendo Kubernetes, OpenShift y open source en el camino, y lo cuento aquí.",
    publicationTitle: "Sobre el blog",
    publication: [
      "Esto no es un feed de noticias. Es mi espacio para compartir lo que voy aprendiendo y lo que voy avanzando, tanto a nivel técnico como personal.",
      "A veces es un problema que resolví en producción, a veces es algo de OpenShift o de open source que me costó entender y quiero explicar como me hubiese gustado que me lo explicaran a mí. La idea es que ayude a alguien más a entender mejor cómo funcionan las cosas.",
    ],
    focusTitle: "De qué hablo",
    focus: [
      "Kubernetes y OpenShift en el día a día real, no solo en el laboratorio",
      "Decisiones de arquitectura cloud native y sus trade-offs",
      "GitOps, automatización y cómo mejorar la experiencia de desarrollo",
      "IA generativa, MCP y agentes corriendo sobre Kubernetes",
      "IA integrada con Java en sistemas que sí están en producción",
    ],
    authorTitle: "Jean Paul López",
    author: [
      "Soy Senior Consultant en Red Hat, llevo más de 8 años metido en software empresarial y en el mundo Kubernetes/OpenShift.",
      "Ayudo a empresas a adoptar cloud native, pero este blog no es material corporativo: es mi bitácora personal. Todo lo que escribo aquí es mi experiencia y mi opinión, con lo bueno y lo que todavía estoy entendiendo.",
      "Si algo de lo que escribo te sirve para avanzar más rápido en tu propio camino, ya cumplió su propósito.",
    ],
    principlesTitle: "Qué vas a encontrar",
    principles: [
      "Notas de campo, no solo tutoriales perfectos",
      "Cómo modernizar sistemas Java grandes sin romper nada",
      "Kubernetes, OpenShift, GitOps e IA explicados desde la práctica",
      "Trade-offs reales de plataformas en producción, con sus dolores incluidos",
    ],
    connectTitle: "Conecta",
  },
  en: {
    title: "About",
    description: `Learn more about ${SITE.author} and blog.labjp.xyz`,
    lead: "I'm learning Kubernetes, OpenShift, and open source along the way, and I write about it here.",
    publicationTitle: "About the blog",
    publication: [
      "This isn't a news feed. It's my space to share what I'm learning and how I'm progressing, both technically and personally.",
      "Sometimes it's a problem I solved in production, sometimes it's something about OpenShift or open source that took me a while to understand, explained the way I wish someone had explained it to me. The goal is to help someone else understand how things actually work.",
    ],
    focusTitle: "What I write about",
    focus: [
      "Kubernetes and OpenShift in day-to-day reality, not just the lab",
      "Cloud-native architecture decisions and their trade-offs",
      "GitOps, automation, and improving developer experience",
      "Generative AI, MCP, and agents running on Kubernetes",
      "AI integrated with Java in systems that are actually in production",
    ],
    authorTitle: "Jean Paul López",
    author: [
      "I'm a Senior Consultant at Red Hat, with over 8 years in enterprise software and the Kubernetes/OpenShift world.",
      "I help companies adopt cloud native, but this blog isn't corporate material: it's my personal notebook. Everything here is my own experience and opinion, the good parts and the parts I'm still figuring out.",
      "If something I write helps you move faster on your own path, it did its job.",
    ],
    principlesTitle: "What you'll find here",
    principles: [
      "Field notes, not just polished tutorials",
      "How to modernize large Java systems without breaking things",
      "Kubernetes, OpenShift, GitOps, and AI explained from practice",
      "Real production platform trade-offs, growing pains included",
    ],
    connectTitle: "Connect",
  },
} as const;

const copy = content[lang];
const links = [
  { label: "GitHub", value: "@jeanlopezxyz", href: SOCIAL.github, icon: "mdi:github" },
  { label: "LinkedIn", value: "jean-paul-lopez", href: SOCIAL.linkedin, icon: "mdi:linkedin" },
  { label: "X", value: "@jeanlopezxyz", href: SOCIAL.twitter, icon: "mdi:twitter" },
  { label: "RSS", value: "blog.labjp.xyz/rss.xml", href: "/rss.xml", icon: "mdi:rss" },
] as const;
---

<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <div class="mx-auto max-w-screen-2xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <header class="mb-8 border-b border-border/70 pb-8">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
        {copy.title}<span class="text-primary">.</span>
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground">{copy.lead}</p>
    </header>

    <div class="grid gap-8 lg:grid-cols-[1fr_18rem] lg:items-start">
      <div class="space-y-9">
        <section aria-labelledby="about-publication">
          <h2 id="about-publication" class="mb-4 text-xl font-semibold">{copy.publicationTitle}</h2>
          <div class="space-y-4 leading-relaxed text-foreground/85">
            {copy.publication.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="border-t border-border/60 pt-8" aria-labelledby="about-focus">
          <h2 id="about-focus" class="mb-4 text-xl font-semibold">{copy.focusTitle}</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {copy.focus.map((item, index) => (
              <li
                class:list={[
                  "border-l border-primary/50 pl-3 text-sm leading-relaxed text-foreground/85",
                  { "sm:col-span-2": index === copy.focus.length - 1 && copy.focus.length % 2 !== 0 },
                ]}
              >
                {item}
              </li>
            ))}
          </ul>
        </section>

        <section class="border-t border-border/60 pt-8" aria-labelledby="about-author">
          <h2 id="about-author" class="mb-4 text-xl font-semibold">{copy.authorTitle}</h2>
          <div class="space-y-4 leading-relaxed text-foreground/85">
            {copy.author.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="border-t border-border/60 pt-8" aria-labelledby="about-principles">
          <h2 id="about-principles" class="mb-4 text-xl font-semibold">{copy.principlesTitle}</h2>
          <ul class="space-y-3 text-foreground/85">
            {copy.principles.map((item) => <li><span class="mr-3 text-primary">→</span>{item}</li>)}
          </ul>
        </section>
      </div>

      <aside class="lg:sticky lg:top-24" aria-labelledby="about-connect">
        <h2 id="about-connect" class="sr-only">{copy.connectTitle}</h2>
        <ul class="space-y-4">
          {links.map((link) => (
            <li>
              <span class="block font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{link.label}</span>
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="mt-1 flex items-center gap-2 text-sm text-foreground transition-colors hover:text-primary hover:underline"
              >
                <Icon name={link.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />
                <span class="break-words">{link.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>
