---
import { Icon } from "astro-icon/components";
import SocialActions from "@/components/ui/SocialActions.astro";
import { formatDate, getBlogPostUrl, getCategoryGradient, getCategoryInfo } from "@/lib/utils";
import { normalizeSlug, slugToPostId, type Lang } from "@/i18n";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  image?: string;
  categories?: string[];
  readingTime?: number;
  lang: Lang;
  showSocialActions?: boolean;
}

const {
  title,
  description,
  pubDate,
  slug,
  image,
  categories = [],
  readingTime,
  lang,
  showSocialActions = true,
} = Astro.props;

const category = getCategoryInfo(categories[0]);
const postUrl = getBlogPostUrl(slug, lang);
const postId = slugToPostId(slug);
---

<article class="terminal-card group flex h-full flex-col overflow-hidden">
  <a href={postUrl} class="flex flex-1 flex-col">
    <div
      class="aspect-video overflow-hidden border-b border-border/60"
      style={`background: ${getCategoryGradient(category.color, 15)}`}
    >
      {image ? (
        <img
          src={image}
          alt={title}
          width="400"
          height="225"
          decoding="async"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <Icon name={category.icon} class="h-12 w-12 opacity-30" style={`color: ${category.color}`} />
        </div>
      )}
    </div>

    <div class="flex flex-1 flex-col p-4">
      {categories.length > 0 && (
        <span class="mb-2 w-fit font-mono text-[11px] uppercase tracking-wider" style={`color: ${category.color}`}>
          ./category/{category.label.toLowerCase()}
        </span>
      )}
      <h3 class="mb-2 line-clamp-2 font-semibold text-foreground transition-colors group-hover:text-primary">
        {title}
      </h3>
      <p class="mb-3 line-clamp-2 flex-1 text-sm text-muted-foreground">{description}</p>
      <div class="mt-auto flex items-center gap-2 font-mono text-xs text-muted-foreground">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        {readingTime && <><span>·</span><span>{readingTime} min</span></>}
      </div>
    </div>
  </a>

  {showSocialActions && (
    <div class="border-t border-border/40 px-4 py-3">
      <SocialActions
        postId={postId}
        postTitle={title}
        postSlug={normalizeSlug(slug)}
        lang={lang}
        showComments={true}
        size="sm"
      />
    </div>
  )}
</article>
