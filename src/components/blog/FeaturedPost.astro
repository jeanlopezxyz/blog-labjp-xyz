---
import SocialActions from "@/components/ui/SocialActions.astro";
import { calculateReadingTime, getBlogPostUrl, getRelativeTime } from "@/lib/utils";
import { normalizeSlug, slugToPostId, type Lang } from "@/i18n";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  body?: string;
  image?: string;
  lang: Lang;
}

const { title, description, pubDate, slug, body = "", image, lang } = Astro.props;
---

<article class="terminal-card group overflow-hidden p-5">
  <a href={getBlogPostUrl(slug, lang)} class="block">
    {image && (
      <div class="mb-5 aspect-[2/1] overflow-hidden rounded-sm bg-muted">
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    )}
    <h2 class="mb-3 text-xl font-bold transition-colors group-hover:text-primary md:text-2xl">{title}</h2>
    <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{description}</p>
    <div class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
      <time datetime={pubDate.toISOString()}>{getRelativeTime(pubDate, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{calculateReadingTime(body)} min</span>
    </div>
  </a>
  <div class="mt-4 border-t border-border/40 pt-4">
    <SocialActions
      postId={slugToPostId(slug)}
      postTitle={title}
      postSlug={normalizeSlug(slug)}
      lang={lang}
      showComments={true}
      size="sm"
    />
  </div>
</article>
