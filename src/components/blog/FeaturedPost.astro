---
import SocialActions from "@/components/ui/SocialActions.astro";
import { calculateReadingTime, getBlogPostUrl, getRelativeTime } from "@/lib/utils";
import { normalizeSlug, slugToPostId, type Lang } from "@/i18n";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  body?: string;
  image?: string;
  lang: Lang;
}

const { title, description, pubDate, slug, body = "", image, lang } = Astro.props;
---

<article class="group border-b border-border/50 pb-6">
  <a href={getBlogPostUrl(slug, lang)} class="flex gap-5">
    <div class="min-w-0 flex-1">
      <h2 class="mb-2 text-lg font-semibold text-foreground transition-colors group-hover:text-primary sm:text-xl">
        {title}
      </h2>
      <p class="mb-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{description}</p>
      <div class="flex items-center gap-2 text-xs text-muted-foreground/80">
        <time datetime={pubDate.toISOString()}>{getRelativeTime(pubDate, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{calculateReadingTime(body)} min</span>
      </div>
    </div>
    {image && (
      <div class="h-20 w-28 flex-shrink-0 overflow-hidden rounded-lg bg-muted sm:h-22 sm:w-32">
        <img
          src={image}
          alt={title}
          width="128"
          height="88"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )}
  </a>
  <div class="mt-3">
    <SocialActions
      postId={slugToPostId(slug)}
      postTitle={title}
      postSlug={normalizeSlug(slug)}
      lang={lang}
      showComments={true}
      size="sm"
    />
  </div>
</article>
