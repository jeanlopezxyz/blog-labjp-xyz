---
import SocialActions from "@/components/ui/SocialActions.astro";
import { calculateReadingTime, getBlogPostUrl, getRelativeTime } from "@/lib/utils";
import { getThumbnailUrl, THUMBNAIL_SIZES } from "@/lib/images";
import { normalizeSlug, slugToPostId, type Lang } from "@/i18n";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  body?: string;
  image?: string;
  lang: Lang;
}

const { title, description, pubDate, slug, body = "", image, lang } = Astro.props;
---

<article class="group border-b border-border/50 pb-3">
  <a href={getBlogPostUrl(slug, lang)} class="flex gap-3">
    <div class="min-w-0 flex-1">
      <h2 class="mb-1 text-sm font-semibold text-foreground transition-colors group-hover:text-primary sm:text-base">
        {title}
      </h2>
      <p class="mb-1.5 line-clamp-2 text-xs leading-snug text-muted-foreground">{description}</p>
      <div class="flex items-center gap-2 text-xs text-muted-foreground">
        <time datetime={pubDate.toISOString()}>{getRelativeTime(pubDate, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{calculateReadingTime(body)} min</span>
      </div>
    </div>
    {image && (
      <div class="h-16 w-20 flex-shrink-0 overflow-hidden rounded-lg bg-muted sm:h-16 sm:w-24">
        <img
          src={getThumbnailUrl(image, THUMBNAIL_SIZES.card)}
          alt={title}
          width="96"
          height="64"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )}
  </a>
  <div class="mt-1.5">
    <SocialActions
      postId={slugToPostId(slug)}
      postTitle={title}
      postSlug={normalizeSlug(slug)}
      lang={lang}
      showComments={true}
      size="sm"
    />
  </div>
</article>
